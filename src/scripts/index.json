{
  "scripts": [
    {
      "id": "crack_search",
      "display_name": "游戏破解状态查询",
      "description": "通过游戏名或关键词搜索游戏破解状态。优先搜索 crackrelease.com（收录较全），无结果时回退 isitcracked.com 补充。返回是否已破解、DRM保护、破解日期、发布日期、场景组等。支持英文游戏名搜索效果最佳。",
      "path": "crack-search",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "游戏名称或关键词，建议用英文。如 'elden ring'、'resident evil'、'aincrad'、'TENOKE'"
          },
          "limit": {
            "type": "integer",
            "description": "每个数据源最大返回结果数量，默认5，最大20"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "timeout_seconds": 120,
      "always_loaded": false,
      "load_policy": "group",
      "groups": [
        "gaming"
      ]
    },
    {
      "id": "goofish_search",
      "display_name": "闲鱼搜索",
      "description": "搜索闲鱼(Goofish)二手交易平台商品，免登录，返回标题、价格(元)、地区、商品链接。action=search(默认): 浏览器实时搜索，约10-40秒，支持pages翻页(每页30条)；monitor-init: 为关键词签发监控票据(浏览器一次)；monitor-query: 用已签发票据纯HTTP秒级查询(须先对同一关键词init，适合反复监控)。依赖 playwright 与 Chromium 系浏览器，缺失时返回报错、修复指引与环境自检，把报错内容告诉用户即可，用户会自行处理。",
      "path": "goofish-search",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "搜索关键词，如 'RTX 4060'、'switch oled'"
          },
          "action": {
            "type": "string",
            "enum": [
              "search",
              "monitor-init",
              "monitor-query"
            ],
            "description": "默认 search"
          },
          "pages": {
            "type": "integer",
            "description": "翻页数量(1-10，默认1，仅 search 有效，每多一页约多10秒)"
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      },
      "timeout_seconds": 300,
      "always_loaded": false,
      "load_policy": "group",
      "groups": [
        "shopping"
      ]
    }
  ]
}