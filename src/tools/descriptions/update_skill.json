{
  "name": "update_skill",
  "display_name": "更新技能草稿",
  "description": "把已有 Skill 复制到隔离草稿中。使用 apply_patch 修改草稿后调用 publish_skill；若 live Skill 同期变化，发布会失败。",
  "parameters": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "已有 Skill 名称。"
      },
      "scope": {
        "type": "string",
        "enum": ["global", "persona"],
        "description": "包含该 Skill 的准确作用域。"
      }
    },
    "required": ["name", "scope"],
    "additionalProperties": false
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "group",
  "groups": ["skills"]
}
