{
  "name": "present_artifact",
  "display_name": "预览文件",
  "description": "将已经存在的完整交付文件展示到 WebUI Artifact 工作区。适用于命令或其他工具生成的报告、PDF、图片和数据文件；新建文本交付物优先使用 create_artifact，普通项目源码修改不要调用。",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "要发布的文件路径"
      },
      "title": {
        "type": "string",
        "description": "可选显示标题"
      }
    },
    "required": ["path"],
    "additionalProperties": false
  },
  "always_loaded": true,
  "load_policy": "summary",
  "groups": ["dev"]
}
