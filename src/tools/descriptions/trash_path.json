{
  "name": "trash_path",
  "display_name": "移入回收站",
  "description": "把文件、目录或符号链接移入系统回收站，而不是永久删除。要删多个时一次性把路径全部放进 paths，逐个调用会刷屏。",
  "parameters": {
    "type": "object",
    "properties": {
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "要移入回收站的路径列表。支持绝对路径、工作区相对路径和 ~/ 路径。删多个文件时一次全部传入，不要分多次调用。"
      }
    },
    "required": [
      "paths"
    ]
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "dev"
  ]
}
