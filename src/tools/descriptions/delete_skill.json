{
  "name": "delete_skill",
  "display_name": "删除技能",
  "description": "从准确的 global 或当前 persona 作用域永久删除已有用户 Skill。",
  "parameters": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "已有 Skill 名称。"
      },
      "scope": {
        "type": "string",
        "enum": ["global", "persona"],
        "description": "包含该 Skill 的准确作用域。"
      }
    },
    "required": ["name", "scope"],
    "additionalProperties": false
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "group",
  "groups": ["skills"]
}
