{
  "name": "online_man_get_page",
  "display_name": "读取在线手册",
  "description": "Fetch a man page from the local man command, falling back to manpagez.com (Apple man pages).",
  "parameters": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "section": {
        "type": "string"
      },
      "source": {
        "type": "string",
        "enum": [
          "auto",
          "local",
          "manpagez"
        ]
      },
      "language": {
        "type": "string"
      },
      "max_chars": {
        "type": "integer",
        "description": "Maximum returned characters. "
      }
    },
    "required": [
      "name"
    ]
  },
  "permission": "readonly",
  "always_loaded": false,
  "load_policy": "summary",
  "groups": [
    "man-docs"
  ]
}
