{
  "name": "create_skill",
  "display_name": "创建技能草稿",
  "description": "为新 Skill 创建隔离草稿。使用返回的绝对路径配合 apply_patch 编辑，完成后调用 publish_skill；绝不覆盖已有 Skill。",
  "parameters": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "符合 Agent Skills 规范的名称。"
      },
      "description": {
        "type": "string",
        "description": "Skill 做什么以及何时应使用。"
      },
      "scope": {
        "type": "string",
        "enum": ["global", "persona"],
        "default": "global",
        "description": "global 对所有人格可用；persona 仅属于当前人格。"
      }
    },
    "required": ["name", "description"],
    "additionalProperties": false
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "group",
  "groups": ["skills"]
}
